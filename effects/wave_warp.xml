<?xml version="1.0" encoding="UTF-8"?>
<effect id="wave-warp" name="Wave Warp" category="warp" icon="assets/FXPH.svg">
  <description>After Effects style wave distortion and animated sine/triangle/square warping</description>
  <params>
    <param id="waveType" label="Wave Type" type="select" default="sine" options="sine,triangle,square,sawtooth" />
    <param id="waveHeight" label="Wave Height" type="number" min="0" max="200" default="25" unit="px" />
    <param id="waveWidth" label="Wave Width" type="number" min="10" max="2000" default="120" unit="px" />
    <param id="direction" label="Direction" type="number" min="0" max="360" default="0" unit="°" />
    <param id="speed" label="Wave Speed" type="number" min="-10" max="10" default="1" step="0.05" unit="x" />
    <param id="phase" label="Phase" type="number" min="0" max="360" default="0" unit="°" />
  </params>
</effect>