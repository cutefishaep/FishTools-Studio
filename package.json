{
  "name": "openfishtools-studio",
  "version": "0.5.88",
  "description": "Professional lightweight browser-based motion graphics video editor in the browser",
  "main": "js/main.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/sync-effects.js",
    "tunnel": "node server.js --tunnel",
    "bump": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js",
    "sync:effects": "node scripts/sync-effects.js",
    "serve": "npx serve .",
    "test": "node scratch/test_suite.js",
    "tauri": "npx @tauri-apps/cli",
    "desktop:dev": "node scripts/build-native-dist.js && npx @tauri-apps/cli dev --config native/src-tauri/tauri.conf.json",
    "desktop:build": "node scripts/build-native-dist.js && npx @tauri-apps/cli build --config native/src-tauri/tauri.conf.json"
  },
  "keywords": [
    "openfishtools",
    "studio",
    "marine"
  ],
  "author": "FishTool Studio Team",
  "license": "MIT",
  "dependencies": {
    "mp4-muxer": "^5.2.2"
  }
}
