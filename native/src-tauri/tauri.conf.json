{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFishTools Studio",
  "version": "0.5.20",
  "identifier": "com.openfishtools.studio",
  "build": {
    "beforeBuildCommand": "node ../../scripts/build-native-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenFishTools Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
